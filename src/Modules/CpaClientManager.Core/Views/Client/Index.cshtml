@model IEnumerable<CpaClientManager.Core.ViewModels.ClientListItemViewModel>

<h1>Clients</h1>
@foreach(var client in Model) {
    <div class="client-details">
        <a href="@Url.RouteUrl(new { area = "OrchardCore.Contents", controller = "Item", action = "Display", contentItemId = client.ContentItemId })">
        @client.LegalName
        </a>
    </div>
}